# Copiar a .env y ajustar
DB_NAME=huerto_hogar
DB_USER=huerto
DB_PASSWORD=huerto
DB_ROOT_PASSWORD=root
DB_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=80

# Seguridad (generar con: openssl rand -base64 48)
JWT_SECRET=
# true cuando el sitio se sirva por HTTPS
JWT_COOKIE_SECURE=false
# en produccion: la URL publica del sitio, ej http://54.123.45.67 o https://huertohogar.cl
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
